{
  "name": "goalterra",
  "private": true,
  "description": "Developer tooling for GoalTerra. The app itself is the single generated file goal-tracker.html.",
  "scripts": {
    "build": "node build.mjs",
    "check": "node build.mjs --check",
    "format": "prettier --write \"src/js/*.js\" src/style.css",
    "format:check": "prettier --check \"src/js/*.js\" src/style.css",
    "test": "tests/run.sh"
  },
  "devDependencies": {
    "prettier": "3.3.3"
  }
}
